APP_NAME=iinfo-dx-backend
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
TIMEZONE=Asia/Seoul

# ── Supabase ──────────────────────────────────────────
# Supabase 대시보드 > Project Settings 에서 확인
SUPABASE_URL=https://your-project-ref.supabase.co

# 레거시(HS256) 프로젝트에서만 설정 (Project Settings > API > JWT Secret).
# 비워두면 JWKS 엔드포인트(비대칭 키, 권장)로 토큰을 검증한다.
SUPABASE_JWT_SECRET=

# 크롤링 결과 쓰기 + Auth(GoTrue) 호출용 서버 키.
# 새 Secret key(sb_secret_..., Project Settings > API Keys > Secret keys) 권장,
# 레거시 service_role JWT도 동작한다. RLS를 우회하므로 절대 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# ── 인증 (백엔드 주도 Supabase Auth) ──────────────────
# OAuth 허용 프로바이더 (JSON 배열 한 줄). 애플 등 추가 시 이름만 늘리면 된다
# (+ Supabase 대시보드에서 프로바이더 활성화, Redirect URLs에 콜백 등록:
#  {API_ORIGIN}/api/v1/web/auth/callback)
OAUTH_PROVIDERS=["google"]
# OAuth 콜백 완료 후 돌아갈 FE URL은 FE가 /auth/login/{provider}?redirect= 로 넘긴다.
# 아래 허용 목록(JSON 배열 한 줄)의 오리진과 일치하는 redirect만 사용하고, 미지정·불일치
# redirect는 목록의 첫 URL(홈)으로 폴백한다. 운영 도메인은 여기에 추가한다.
OAUTH_ALLOWED_REDIRECT_URLS=["http://localhost:3000"]
# 어드민 전용 로그인(/api/v1/admin/auth)의 OAuth 완료 후 허용 리다이렉트 URL 목록.
# 어드민 FE는 사용자 클라이언트와 별도 오리진이므로 위 목록과 분리한다(JSON 배열 한 줄).
# 어드민 OAuth 콜백은 {API_ORIGIN}/api/v1/admin/auth/callback — Supabase Redirect URLs에도 등록.
ADMIN_ALLOWED_REDIRECT_URLS=["http://localhost:3001"]
# 인증 쿠키(refresh token) SameSite 정책. FE가 API와 다른 사이트(등록 도메인이
# 다름)이면 none으로 (Secure 자동 강제, HTTPS 필수). 같은 도메인/서브도메인이면 lax.
AUTH_COOKIE_SAMESITE=lax

# ── 크롤링 ────────────────────────────────────────────
REQUEST_TIMEOUT=15
# 곡 마스터 크롤 타깃 (JSON 배열 한 줄). 예시:
# SONG_CRAWL_TARGETS=[{"crawler":"textage"}]
SONG_CRAWL_TARGETS=[{"crawler":"textage"}]
# 난이도표 크롤 타깃 (구 CRAWL_TARGETS, JSON 배열 한 줄). 예시:
# TABLE_CRAWL_TARGETS=[{"crawler":"5ch_sheet","url":"https://docs.google.com/spreadsheets/.../pubhtml","play_style":"SP","level":12},{"crawler":"5ch_sheet","url":"https://docs.google.com/spreadsheets/.../pubhtml","play_style":"DP","level":12}]
# 5ch_sheet 선택 키: "name"(표 이름, 기본 "5ch SP☆12" 형식), "slug"(기본 "5ch-sp12" 형식)
TABLE_CRAWL_TARGETS=[]

# ── 주간 크롤링 스케줄 (곡 마스터 → 난이도표 순차, 기본: 매주 월요일 05:00, TIMEZONE 기준) ──
# 어드민 API(PUT /api/v1/admin/crawl/schedule)로 변경하면 Redis에 저장되어 아래 값보다 우선한다.
CRAWL_SCHEDULE_ENABLED=true
CRAWL_SCHEDULE_DAY=mon
CRAWL_SCHEDULE_HOUR=5
CRAWL_SCHEDULE_MINUTE=0

# ── Redis (크롤 작업 상태 저장 · 재기동 시 이어하기, 스케줄 오버라이드) ──
# docker compose에서는 compose가 redis://redis:6379/0 으로 덮어쓴다 (아래 값은 로컬 venv용).
REDIS_URL=redis://localhost:6379/0

# ── 어드민 API ────────────────────────────────────────
# 어드민 권한은 env가 아니라 Supabase 계정의 app_metadata.role("ADMIN")로 판정한다.
# 부여 방법은 README '어드민 권한 부여' 참고.

# 별도 FE(클라이언트/어드민) 오리진 CORS 허용 목록 (JSON 배열 한 줄, 비우면 CORS 미적용)
CORS_ORIGINS=[]
