APP_NAME=iinfo-dx-backend
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
TIMEZONE=Asia/Seoul

# ── Supabase ──────────────────────────────────────────
# Supabase 대시보드 > Project Settings 에서 확인
SUPABASE_URL=https://your-project-ref.supabase.co

# 레거시(HS256) 프로젝트에서만 설정 (Project Settings > API > JWT Secret).
# 비워두면 JWKS 엔드포인트(비대칭 키, 권장)로 토큰을 검증한다.
SUPABASE_JWT_SECRET=

# 크롤링 결과 쓰기용 (Project Settings > API > service_role).
# RLS를 우회하는 키이므로 절대 클라이언트/저장소에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# ── 크롤링 ────────────────────────────────────────────
REQUEST_TIMEOUT=15
# 크롤링 대상 (JSON 배열 한 줄). 예시:
# CRAWL_TARGETS=[{"crawler":"5ch_sheet","url":"https://docs.google.com/spreadsheets/.../pubhtml","play_style":"SP","level":12},{"crawler":"5ch_sheet","url":"https://docs.google.com/spreadsheets/.../pubhtml","play_style":"DP","level":12}]
CRAWL_TARGETS=[]

# ── 주간 크롤링 스케줄 (기본: 매주 월요일 05:00, TIMEZONE 기준) ──
CRAWL_SCHEDULE_ENABLED=true
CRAWL_SCHEDULE_DAY=mon
CRAWL_SCHEDULE_HOUR=5
CRAWL_SCHEDULE_MINUTE=0
