APP_NAME=iinfo-dx-backend
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true

# ── Supabase 인증 ─────────────────────────────────────
# Supabase 대시보드 > Project Settings 에서 확인
SUPABASE_URL=https://your-project-ref.supabase.co

# 레거시(HS256) 프로젝트에서만 설정 (Project Settings > API > JWT Secret).
# 비워두면 JWKS 엔드포인트(비대칭 키, 권장)로 토큰을 검증한다.
SUPABASE_JWT_SECRET=
